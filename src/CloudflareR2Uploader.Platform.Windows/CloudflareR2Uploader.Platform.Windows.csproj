<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CloudflareR2Uploader</RootNamespace>
    <AssemblyName>CloudflareR2Uploader.Platform.Windows</AssemblyName>
    <Description>Windows integration: DPAPI credential protection, per-user startup registration, single-instance coordination, notification-area host, OS theme detection and verified updates.</Description>

    <!--
      TrayIconHost wraps System.Windows.Forms.NotifyIcon, the supported Shell_NotifyIcon
      wrapper in the Windows Desktop pack.
    -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudflareR2Uploader.Core\CloudflareR2Uploader.Core.csproj" />
    <ProjectReference Include="..\CloudflareR2Uploader.Infrastructure.R2\CloudflareR2Uploader.Infrastructure.R2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudflareR2Uploader.Platform.Tests" />
    <InternalsVisibleTo Include="CloudflareR2Uploader.Wpf" />
    <InternalsVisibleTo Include="CloudflareR2Uploader.Wpf.Tests" />
  </ItemGroup>

</Project>
