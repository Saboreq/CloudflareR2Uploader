<?xml version="1.0" encoding="utf-8"?>
<Weavers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="FodyWeavers.xsd">
  <!--
    Costura embeds every managed dependency (AWSSDK.S3, AWSSDK.Core, ...) directly into
    CloudflareR2Uploader.exe so the Release distribution is a single file.

    DisableCompression=false  -> dependencies are deflate-compressed inside the EXE.
    DisableCleanup=false      -> the loose DLL/PDB copies are removed from the output folder.
    IncludeDebugSymbols=false -> no embedded PDBs, no PDBs in the distribution.
    CreateTemporaryAssemblies=false -> assemblies are loaded straight from memory.
  -->
  <Costura DisableCompression="false"
           DisableCleanup="false"
           IncludeDebugSymbols="false"
           CreateTemporaryAssemblies="false" />
</Weavers>
