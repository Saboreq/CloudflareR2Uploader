<!--
    Dialog chrome and toasts, matching the DIALOG ANATOMY and TOASTS blocks of
    Images/09-design-system-components.png.

    Dialogs: elevated surface, strong border, fixed header, scrollable body, fixed footer.
    Focus is trapped inside with KeyboardNavigation.TabNavigation="Cycle", Escape cancels,
    Enter activates the default button, and the invoking control is refocused on close.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls">

    <!-- dialog -->

    <Style x:Key="Dialog.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <!-- WindowStartupLocation is a CLR property, so ThemedDialogWindow sets it
             in its constructor instead of trying to use a WPF Style setter. -->
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    </Style>

    <Style x:Key="Dialog.Header" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,11,14,11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Dialog.Footer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Dialog.Body" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Padding" Value="20,18,20,18" />
    </Style>

    <Style x:Key="Dialog.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dialog.Message" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- toasts -->

    <Style x:Key="Toast.Base" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="12,9,10,9" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Toast.Success" TargetType="Border" BasedOn="{StaticResource Toast.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
    </Style>

    <Style x:Key="Toast.Error" TargetType="Border" BasedOn="{StaticResource Toast.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style x:Key="Toast.Progress" TargetType="Border" BasedOn="{StaticResource Toast.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
    </Style>

    <Style x:Key="Toast.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Modal scrim drawn behind an in-window overlay. -->
    <Style x:Key="Overlay.Scrim" TargetType="Border">
        <Setter Property="Background" Value="#B0000000" />
    </Style>

    <!-- panel chrome -->

    <Style x:Key="Panel.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.Toolbar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Text.StatusBar" TargetType="TextBlock" BasedOn="{StaticResource Text.ColumnHeader}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.StatusBarMuted" TargetType="TextBlock" BasedOn="{StaticResource Text.StatusBar}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Text.StatusBarAccent" TargetType="TextBlock" BasedOn="{StaticResource Text.StatusBar}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- Vertical hairline used to separate status-bar segments. -->
    <Style x:Key="Separator.StatusBar" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Border}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
