<!--
    Buttons, matching the BUTTONS block of Images/08-design-system-overview.png.

    28 px in toolbars, 30-32 px in dialogs, one primary per surface. Five states each:
    default, hover, pressed, focused, disabled. Focus is the shared ring from
    Controls.Focus.xaml and is drawn in addition to whatever the state fill is.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls">

    <!-- Shared chrome for every button variant. Only the brushes differ. -->
    <ControlTemplate x:Key="Button.Template" TargetType="ButtonBase">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource Size.ToolbarControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Primary: filled accent. One per surface. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary: elevated surface with a hairline. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost: no chrome until hovered. Used for Cancel and low-emphasis actions. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Danger: outlined until hovered, then filled. Destructive actions only. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Link: text-only accent action, e.g. "Manage buckets". -->
    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Padding" Value="2,0,2,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Icon button, 28 px square. Content is a PathGeometry supplied through the attached
        controls:Icon.Data property so the same style covers every glyph. Icon-only controls
        always need a ToolTip and an AutomationProperties.Name at the call site.
    -->
    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
        <Setter Property="Width" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Height" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Glyph"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding Path=(controls:Icon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                              Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Elevated}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar icon button without a border, for dense rows such as the inspector header. -->
    <Style x:Key="Button.IconBorderless" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- Accent icon button, used for the active view-mode segment and the inspector toggle. -->
    <Style x:Key="Button.IconAccent" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!--
        Button with a leading icon and a label, which is what most of the toolbar uses.
        The icon geometry comes from controls:Icon.Data, the label from Content. One
        template serves every colour variant because only the brushes differ.
    -->
    <ControlTemplate x:Key="Button.IconLabelTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                SnapsToDevicePixels="True">
            <StackPanel Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Path Width="13"
                      Height="13"
                      Margin="0,0,7,0"
                      VerticalAlignment="Center"
                      Data="{Binding Path=(controls:Icon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                      Stretch="Uniform"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <ContentPresenter VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.PrimaryWithIcon" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Template" Value="{StaticResource Button.IconLabelTemplate}" />
    </Style>

    <Style x:Key="Button.SecondaryWithIcon" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Template" Value="{StaticResource Button.IconLabelTemplate}" />
    </Style>

    <Style x:Key="Button.GhostWithIcon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Template" Value="{StaticResource Button.IconLabelTemplate}" />
    </Style>

    <Style x:Key="Button.DangerWithIcon" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
        <Setter Property="Template" Value="{StaticResource Button.IconLabelTemplate}" />
    </Style>

</ResourceDictionary>
