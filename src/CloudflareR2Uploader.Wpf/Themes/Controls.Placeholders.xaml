<!--
    Empty, loading, unsupported and error placeholders, matching the INSPECTOR PREVIEW and
    EMPTY FOLDER blocks of Images/09-design-system-components.png.

    The reference note is the requirement: "the preview area keeps its box in every state so
    the panel never jumps". Every placeholder therefore fills the same slot rather than
    collapsing it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Placeholder.Box" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Nothing selected: dashed outline so it reads as an absence, not as a failure. -->
    <Style x:Key="Placeholder.Empty" TargetType="Border" BasedOn="{StaticResource Placeholder.Box}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Placeholder.Error" TargetType="Border" BasedOn="{StaticResource Placeholder.Box}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style x:Key="Placeholder.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="12,0,12,0" />
    </Style>

    <Style x:Key="Placeholder.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Margin" Value="12,6,12,0" />
    </Style>

    <Style x:Key="Placeholder.ErrorTitle" TargetType="TextBlock" BasedOn="{StaticResource Placeholder.Title}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <!--
        Skeleton row shown while a page is loading. A static block rather than an animated
        shimmer: an animation running behind a list that is about to be replaced costs a
        composition pass per frame for no information gain.
    -->
    <Style x:Key="Skeleton.Block" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Skeleton}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Height" Value="9" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
