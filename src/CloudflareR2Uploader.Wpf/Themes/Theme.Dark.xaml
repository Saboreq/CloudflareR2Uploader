<!--
    Dark palette. These are the Paper design tokens read from
    Images/08-design-system-overview.png and are the baseline the whole UI is drawn against.

    Every brush here is also defined in Theme.Light.xaml under the same key, and consumers
    always bind with DynamicResource, so switching theme swaps this dictionary without
    rebuilding a single view.

    Brushes are frozen: they are shared by thousands of visuals and never change once built.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <!-- Surfaces stack from ground to elevated. -->
    <SolidColorBrush x:Key="Brush.Background"    Color="#08090E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"       Color="#101119" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface2"      Color="#151620" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Elevated"      Color="#1A1B27" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RowHover"      Color="#171826" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"        Color="#292B38" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#3A3D4E" po:Freeze="True" />

    <!-- Text. -->
    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#F4F5F8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A8ACBA" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#73798C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FFFFFF" po:Freeze="True" />

    <!-- Purple is reserved for active navigation, selection, progress, focus and primary actions. -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#8B5CF6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#9E76F8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#7C4DEB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentWash"    Color="#1C1733" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentBorder"  Color="#4A3A80" po:Freeze="True" />

    <!-- Status. Every status is also carried by text, never by colour alone. -->
    <SolidColorBrush x:Key="Brush.Success"       Color="#45D6A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessWash"   Color="#0F2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning"       Color="#F1B85B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WarningWash"   Color="#2A2113" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Danger"        Color="#FF647C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.DangerWash"    Color="#2C151C" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#23252F" po:Freeze="True" />

    <!-- Inputs sit on the ground colour so they read as wells rather than as raised cards. -->
    <SolidColorBrush x:Key="Brush.InputBackground"         Color="#08090E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.InputBackgroundDisabled" Color="#0E0F16" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.ScrollBarThumb"      Color="#33364A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ScrollBarThumbHover" Color="#464A63" po:Freeze="True" />

    <!-- Skeleton loading rows. -->
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#1E2030" po:Freeze="True" />

</ResourceDictionary>
