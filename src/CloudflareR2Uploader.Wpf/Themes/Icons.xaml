                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- Navigation and toolbar -->
    <PathGeometry x:Key="Icon.Upload" Figures="M12 20 L12 5 M6 11 L12 5 L18 11" po:Freeze="True" />
    <PathGeometry x:Key="Icon.Folder" Figures="M3 7 A1 1 0 0 1 4 6 L9.5 6 L11.5 8.5 L20 8.5 A1 1 0 0 1 21 9.5 L21 18 A1 1 0 0 1 20 19 L4 19 A1 1 0 0 1 3 18 Z" po:Freeze="True" />
