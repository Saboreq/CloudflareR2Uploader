<!--
    Typography, read from the scale in Images/08-design-system-overview.png.

    Inter across the UI, JetBrains Mono for anything the user copies. Both are declared as
    fallback chains so the app looks right when they are installed and still looks correct
    when they are not; no font files are packaged.

    Sizes are in device-independent pixels, which is what the reference measurements are in.
    Densities stay compact — this is a desktop utility, not a web page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="Fonts.Ui">pack://application:,,,/Resources/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Fonts.Mono">JetBrains Mono, Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="Font.Size.PageTitle">26</sys:Double>
    <sys:Double x:Key="Font.Size.SectionTitle">20</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">14</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Value">12</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.GroupHeader">10</sys:Double>
    <sys:Double x:Key="Font.Size.Mono">11.5</sys:Double>

    <!-- 26 / 600 / -0.03em — dialog and page titles. -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- 20 / 600 / -0.02em — settings section titles. -->
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- 14 / 600 — inspector title, application name. -->
    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- 13 / 400-500 — buttons and table rows. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 12 / 400 — values and secondary cells. -->
    <Style x:Key="Text.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Value}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 11 / 600 / +0.03em — column heads and the status bar. -->
    <Style x:Key="Text.ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- 10 / 700 / +0.08em — FILE DETAILS, UPLOAD QUEUE, DESTINATION. -->
    <Style x:Key="Text.GroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.GroupHeader}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- JetBrains Mono 11-12 — keys, ETags, URLs, part counters. -->
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.MonoPrimary" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

</ResourceDictionary>
