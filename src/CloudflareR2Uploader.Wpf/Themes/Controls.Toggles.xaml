<!--
    Toggle switch and checkbox, matching the TOGGLE and CHECKBOX blocks of
    Images/09-design-system-components.png.

    The switch is the settings affordance; the checkbox is the table selection affordance and
    also appears in dialogs. Both keep the shared focus ring and both are operable with
    Space and Enter through the default ToggleButton input handling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- toggle switch -->

    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Pill}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track"
                                Background="{DynamicResource Brush.ProgressTrack}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.ToggleTrack}"
                                SnapsToDevicePixels="True" />
                        <!-- A 14 px square with a 7 px radius is a circle, which is correct here. -->
                        <Border x:Name="Thumb"
                                Width="14"
                                Height="14"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.TextSecondary}"
                                CornerRadius="{StaticResource Radius.ToggleThumb}"
                                SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Brush.TextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- checkbox -->

    <Style x:Key="CheckBox.Default" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.InputBackground}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="Tick"
                                      Width="9"
                                      Height="9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon.Check}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.TextOnAccent}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                                <Rectangle x:Name="Dash"
                                           Width="8"
                                           Height="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource Brush.TextOnAccent}"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="Label"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings rows put the switch first and a describing label after it. -->
    <Style x:Key="Text.ToggleCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

</ResourceDictionary>
