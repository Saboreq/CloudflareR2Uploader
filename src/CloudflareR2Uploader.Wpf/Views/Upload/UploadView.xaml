<UserControl x:Class="CloudflareR2Uploader.Wpf.Views.Upload.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
             xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Upload"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadViewModel}"
             AllowDrop="True"
             Background="{DynamicResource Brush.Background}"
             Focusable="False">

    <UserControl.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseFilesCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding BrowseFolderCommand}" />
    </UserControl.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Text.StatusBar}" Text="{Binding StatusBarText}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.StatusBarMuted}" Text="{Binding ConcurrencyText}" />
            </Grid>
        </Border>

        <!-- Overall progress -->
        <Border DockPanel.Dock="Bottom"
                Margin="16,0,16,12"
                Padding="16,12,16,12"
                Style="{StaticResource Panel.Card}"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.GroupHeader}" Text="OVERALL PROGRESS" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Text.Mono}"
                               Text="{Binding OverallTransferredText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar AutomationProperties.Name="Overall upload progress"
                                 Style="{StaticResource ProgressBar.Overall}"
                                 Value="{Binding OverallPercent, Mode=OneWay}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Value}" Text="elapsed" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Mono}" Text="{Binding ElapsedText}" />
                        <TextBlock Margin="14,0,0,0" Style="{StaticResource Text.Value}" Text="remaining" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Mono}" Text="{Binding RemainingText}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Value}"
                           Text="{Binding CountsText}" />

                <TextBlock Grid.Column="3"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.PageTitle}"
                           Text="{Binding OverallPercent, StringFormat={}{0:0}%}" />
            </Grid>
        </Border>

        <ScrollViewer Padding="16,14,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Drop zone -->
                <Border x:Name="DropZone"
                        Height="150"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                    <Rectangle RadiusX="8"
                               RadiusY="8"
                               IsHitTestVisible="False"
                               Stroke="{DynamicResource Brush.AccentBorder}"
                               StrokeDashArray="2,2"
                               StrokeThickness="1" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.AccentWash}"
                                BorderBrush="{DynamicResource Brush.AccentBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Path Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.CloudUpload}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>

                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.Subtitle}"
                                   Text="Drop files or folders here" />

                        <TextBlock Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.Value}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="Multipart enabled · no size limit · resumes on reconnect" />

                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button controls:Icon.Data="{StaticResource Icon.File}"
                                    AutomationProperties.Name="Browse for files"
                                    Command="{Binding BrowseFilesCommand}"
                                    Content="Browse files"
                                    Height="{StaticResource Size.DialogControlHeight}"
                                    Style="{StaticResource Button.PrimaryWithIcon}" />
                            <Button Margin="8,0,0,0"
                                    controls:Icon.Data="{StaticResource Icon.Folder}"
                                    AutomationProperties.Name="Browse for a folder"
                                    Command="{Binding BrowseFolderCommand}"
                                    Content="Browse folder"
                                    Height="{StaticResource Size.DialogControlHeight}"
                                    Style="{StaticResource Button.SecondaryWithIcon}" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- Destination -->
                <Border Margin="0,12,0,0" Padding="16,14,16,16" Style="{StaticResource Panel.Card}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Folder}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextMuted}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                            <TextBlock Style="{StaticResource Text.GroupHeader}" Text="DESTINATION" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,24,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="11"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Value}"
                                           Text="Folder / prefix" />
                                <TextBox Grid.Column="1"
                                         controls:Placeholder.Text="assets/builds/"
                                         AutomationProperties.Name="Destination folder or prefix"
                                         Style="{StaticResource TextBox.Mono}"
                                         Text="{Binding DestinationPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="11"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Value}"
                                           Text="Object name" />
                                <TextBox Grid.Column="1"
                                         controls:Placeholder.Text="Keep original filename"
                                         AutomationProperties.HelpText="Only used when exactly one file is queued."
                                         AutomationProperties.Name="Object name override"
                                         Style="{StaticResource TextBox.Mono}"
                                         Text="{Binding ObjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Only applied when exactly one file is queued" />
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PolicyLabel" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Value}"
                                           Text="If the key exists" />
                                <ComboBox Grid.Column="1"
                                          Width="200"
                                          AutomationProperties.Name="Behaviour when the key already exists"
                                          DisplayMemberPath="DisplayName"
                                          ItemContainerStyle="{StaticResource ComboBoxItem.Default}"
                                          ItemsSource="{Binding OverwriteChoices}"
                                          SelectedItem="{Binding SelectedOverwriteChoice, Mode=TwoWay}"
                                          Style="{StaticResource ComboBox.Default}" />
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PolicyLabel" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Value}"
                                           Text="Folder structure" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton AutomationProperties.Name="Keep the source folder structure"
                                                  IsChecked="{Binding PreserveFolderStructure, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                    <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Keep source folder structure" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Queue -->
                <Border Margin="0,12,0,12" Style="{StaticResource Panel.Card}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top"
                                Padding="16,10,10,10"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.GroupHeader}"
                                           Text="UPLOAD QUEUE" />

                                <Border Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Badge.Count}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource Badge.Text}"
                                               Text="{Binding QueueCount}" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button controls:Icon.Data="{StaticResource Icon.Upload}"
                                            AutomationProperties.Name="Upload everything in the queue"
                                            Command="{Binding UploadAllCommand}"
                                            Content="Upload all"
                                            IsEnabled="{Binding CanUploadAll}"
                                            Style="{StaticResource Button.PrimaryWithIcon}" />

                                    <Button Margin="8,0,0,0"
                                            controls:Icon.Data="{StaticResource Icon.Pause}"
                                            AutomationProperties.Name="Pause or resume the queue"
                                            Command="{Binding TogglePauseCommand}"
                                            IsEnabled="{Binding CanPause}"
                                            Style="{StaticResource Button.SecondaryWithIcon}"
                                            ToolTip="Pause after the parts already in flight finish">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Pause" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Text" Value="Resume" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>

                                    <Button Margin="8,0,0,0"
                                            controls:Icon.Data="{StaticResource Icon.Close}"
                                            AutomationProperties.Name="Cancel the queue"
                                            Command="{Binding CancelCommand}"
                                            Content="Cancel"
                                            IsEnabled="{Binding CanCancel}"
                                            Style="{StaticResource Button.SecondaryWithIcon}" />

                                    <Button Margin="8,0,0,0"
                                            controls:Icon.Data="{StaticResource Icon.Refresh}"
                                            AutomationProperties.Name="Retry the failed uploads"
                                            Command="{Binding RetryFailedCommand}"
                                            Content="Retry failed"
                                            IsEnabled="{Binding CanRetryFailed}"
                                            Style="{StaticResource Button.SecondaryWithIcon}" />

                                    <Button Margin="8,0,0,0"
                                            AutomationProperties.Name="Clear the completed rows"
                                            Command="{Binding ClearCompletedCommand}"
                                            Content="Clear completed"
                                            IsEnabled="{Binding CanClearCompleted}"
                                            Style="{StaticResource Button.Ghost}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--
                            Docked to the top explicitly: an undocked DockPanel child docks
                            Left, which would pin this block against the left edge instead of
                            letting HorizontalAlignment centre it.
                        -->
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,36,0,36"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasItems, Converter={StaticResource BoolToCollapsed}}">
                            <TextBlock Style="{StaticResource Placeholder.Title}" Text="The queue is empty" />
                            <TextBlock Style="{StaticResource Placeholder.Caption}"
                                       Text="Drop files above, or use Browse files to add some." />
                        </StackPanel>

                        <ItemsControl MaxHeight="420"
                                      AutomationProperties.Name="Upload queue"
                                      ItemsSource="{Binding Rows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8,10,8"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status glyph -->
                                            <Border Grid.Column="0"
                                                    Width="26"
                                                    Height="26"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="{StaticResource Radius.Control}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Uploading">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningWash}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Path Width="13"
                                                      Height="13"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Clock}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Uploading">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.ArrowUp}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Pause}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Alert}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock MaxWidth="260"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource Text.Body}"
                                                               Text="{Binding FileName}"
                                                               ToolTip="{Binding FileName}" />

                                                    <Border Margin="9,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Badge.Queued}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Uploading">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningWash}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding StatusText}" />
                                                    </Border>

                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Mono}"
                                                               Text="{Binding DetailText}" />
                                                </StackPanel>

                                                <ProgressBar Margin="0,8,0,0"
                                                             AutomationProperties.Name="{Binding AutomationName}"
                                                             Value="{Binding Percent, Mode=OneWay}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar.Row}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Margin="16,0,12,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding TransferredText}" />
                                                <TextBlock Margin="5,0,0,0"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           Style="{StaticResource Text.Mono}"
                                                           Text="/" />
                                                <TextBlock Margin="5,0,0,0" Style="{StaticResource Text.Mono}" Text="{Binding TotalSizeText}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           MinWidth="72"
                                                           Style="{StaticResource Text.Mono}"
                                                           Text="{Binding SpeedText}"
                                                           TextAlignment="Right" />
                                                <TextBlock Margin="12,0,0,0"
                                                           MinWidth="62"
                                                           Style="{StaticResource Text.Mono}"
                                                           Text="{Binding RemainingText}"
                                                           TextAlignment="Right" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button controls:Icon.Data="{StaticResource Icon.Pause}"
                                                        AutomationProperties.Name="Pause this upload"
                                                        Command="{Binding PauseOrResumeCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Pause"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVisible}}" />

                                                <Button controls:Icon.Data="{StaticResource Icon.Play}"
                                                        AutomationProperties.Name="Resume this upload"
                                                        Command="{Binding PauseOrResumeCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Resume"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVisible}}" />

                                                <Button controls:Icon.Data="{StaticResource Icon.Refresh}"
                                                        AutomationProperties.Name="Retry this upload"
                                                        Command="{Binding RetryCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Retry"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisible}}" />

                                                <Button controls:Icon.Data="{StaticResource Icon.Link}"
                                                        AutomationProperties.Name="Copy the public link"
                                                        Command="{Binding CopyLinkCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Copy the public link"
                                                        Visibility="{Binding CanCopyLink, Converter={StaticResource BoolToVisible}}" />

                                                <Button Margin="6,0,0,0"
                                                        controls:Icon.Data="{StaticResource Icon.Close}"
                                                        AutomationProperties.Name="Cancel this upload"
                                                        Command="{Binding CancelCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Cancel"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisible}}" />

                                                <Button Margin="6,0,0,0"
                                                        controls:Icon.Data="{StaticResource Icon.Trash}"
                                                        AutomationProperties.Name="Remove this row"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource Button.Icon}"
                                                        ToolTip="Remove from the queue"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisible}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
