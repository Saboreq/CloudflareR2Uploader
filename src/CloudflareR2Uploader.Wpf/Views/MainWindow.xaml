<Window x:Class="CloudflareR2Uploader.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:activity="clr-namespace:CloudflareR2Uploader.Wpf.Views.Activity"
        xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
        xmlns:files="clr-namespace:CloudflareR2Uploader.Wpf.Views.Files"
        xmlns:upload="clr-namespace:CloudflareR2Uploader.Wpf.Views.Upload"
        xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels"
        xmlns:vmActivity="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Activity"
        xmlns:vmFiles="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Files"
        xmlns:vmUpload="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Upload"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Width="1280"
        Height="840"
        MinWidth="1040"
        MinHeight="660"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Fonts.Ui}"
        FontSize="{StaticResource Font.Size.Body}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--
            Each page keeps its own view model instance for the lifetime of the window, so
            switching pages never discards a running upload queue or a loaded listing.
        -->
        <DataTemplate DataType="{x:Type vmFiles:FilesViewModel}">
            <files:FilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUpload:UploadViewModel}">
            <upload:UploadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmActivity:ActivityViewModel}">
            <activity:ActivityView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="U" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ShellPage.Upload}" />
        <KeyBinding Key="B" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ShellPage.Files}" />
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ShellPage.Activity}" />
        <KeyBinding Key="O" Modifiers="Alt" Command="{Binding BrowseFilesCommand}" />
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding BrowseFolderCommand}" />
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding StartUploadsCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="16,9,16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Product mark -->
                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.AccentWash}"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}">
                        <Path Width="16"
                              Height="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Cloud}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Cloudflare R2 Uploader" />

                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Dot.Status}">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Failed">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Testing">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- The status is always a word, never colour alone. -->
                            <TextBlock Text="{Binding ConnectionText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Style="{StaticResource Text.Value}"
                                       Text="·" />
                            <TextBlock Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Style="{StaticResource Text.Value}"
                                       Text="{Binding ProfileSummary}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Style="{StaticResource Text.ColumnHeader}"
                                   Text="TARGET BUCKET" />

                        <ComboBox Width="200"
                                  AutomationProperties.Name="Target bucket"
                                  DisplayMemberPath="DisplayName"
                                  ItemContainerStyle="{StaticResource ComboBoxItem.Default}"
                                  ItemsSource="{Binding Buckets}"
                                  SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                                  Style="{StaticResource ComboBox.Default}"
                                  ToolTip="Switch the active bucket profile" />

                        <Button Margin="12,0,0,0"
                                controls:Icon.Data="{StaticResource Icon.Settings}"
                                AutomationProperties.HelpText="Opens the Settings window"
                                AutomationProperties.Name="Settings"
                                Command="{Binding OpenSettingsCommand}"
                                Content="_Settings"
                                Height="{StaticResource Size.InputHeight}"
                                Style="{StaticResource Button.SecondaryWithIcon}"
                                ToolTip="Settings (Ctrl+,)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <StackPanel Margin="16,0,16,0" Orientation="Horizontal">
                    <RadioButton controls:Icon.Data="{StaticResource Icon.Upload}"
                                 AutomationProperties.Name="Upload page"
                                 Content="_Upload"
                                 GroupName="ShellNav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Upload, Mode=TwoWay}"
                                 Style="{StaticResource Tab.Navigation}"
                                 ToolTip="Upload queue (Alt+U)" />

                    <RadioButton controls:Icon.Data="{StaticResource Icon.Folder}"
                                 AutomationProperties.Name="Files page"
                                 Content="_Files"
                                 GroupName="ShellNav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Files, Mode=TwoWay}"
                                 Style="{StaticResource Tab.Navigation}"
                                 ToolTip="Browse the bucket (Alt+B)" />

                    <RadioButton controls:Icon.Data="{StaticResource Icon.Clock}"
                                 AutomationProperties.Name="Activity page"
                                 Content="_Activity"
                                 GroupName="ShellNav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Activity, Mode=TwoWay}"
                                 Style="{StaticResource Tab.Navigation}"
                                 ToolTip="Operation history (Alt+A)" />

                    <Border Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Badge.Count}"
                            Visibility="{Binding Activity.UnreadCount, Converter={StaticResource ZeroCountToCollapsed}}">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource Badge.Text}"
                                   Text="{Binding Activity.UnreadCount}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Page -->
            <ContentControl Content="{Binding CurrentPageViewModel}" Focusable="False" />
        </DockPanel>

        <!-- Toast area, bottom right, above everything else. -->
        <ItemsControl Margin="0,0,18,44"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="True"
                      ItemsSource="{Binding Toasts.Toasts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border MinWidth="300">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Toast.Base}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Progress">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                <Setter Property="Data" Value="{StaticResource Icon.Alert}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Progress">
                                                <Setter Property="Data" Value="{StaticResource Icon.Upload}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Toast.Text}" Text="{Binding Message}" />
                                <ProgressBar Margin="0,7,0,0"
                                             Style="{StaticResource ProgressBar.Row}"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Visibility="{Binding ShowsProgress, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Height="22"
                                    Command="{Binding InvokeCommand}"
                                    Content="{Binding ActionLabel}"
                                    Style="{StaticResource Button.Secondary}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisible}}" />

                            <Button Grid.Column="3"
                                    Margin="6,0,0,0"
                                    controls:Icon.Data="{StaticResource Icon.Close}"
                                    AutomationProperties.Name="Dismiss notification"
                                    Command="{Binding DismissCommand}"
                                    Style="{StaticResource Button.IconBorderless}"
                                    ToolTip="Dismiss" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
