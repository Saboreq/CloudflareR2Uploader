<UserControl x:Class="CloudflareR2Uploader.Wpf.Views.Files.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
             xmlns:files="clr-namespace:CloudflareR2Uploader.Wpf.Views.Files"
             xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Files"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
             Background="{DynamicResource Brush.Background}"
             Focusable="False">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Back" Command="{Binding GoUpCommand}" />
        <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusFilterCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyKeysCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding CopyKeysCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyPublicUrlsCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DownloadCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
    </UserControl.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8,12,8" Style="{StaticResource Panel.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button controls:Icon.Data="{StaticResource Icon.ChevronLeft}"
                            AutomationProperties.Name="Back"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Return to the previously visited folder" />

                    <Button Margin="6,0,0,0"
                            controls:Icon.Data="{StaticResource Icon.ArrowUp}"
                            AutomationProperties.Name="Parent folder"
                            Command="{Binding GoUpCommand}"
                            IsEnabled="{Binding CanGoUp}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Open the parent prefix (Backspace)" />

                    <Button Margin="6,0,0,0"
                            controls:Icon.Data="{StaticResource Icon.Refresh}"
                            AutomationProperties.Name="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Reload this prefix (F5)" />

                    <Button Margin="12,0,0,0"
                            controls:Icon.Data="{StaticResource Icon.Upload}"
                            AutomationProperties.Name="Go to the upload queue"
                            Command="{Binding GoToUploadCommand}"
                            Content="Upload"
                            Style="{StaticResource Button.PrimaryWithIcon}"
                            ToolTip="Switch to the Upload page (Alt+U)" />

                    <Button Margin="6,0,0,0"
                            controls:Icon.Data="{StaticResource Icon.NewFolder}"
                            AutomationProperties.Name="New folder"
                            Command="{Binding NewFolderCommand}"
                            Content="New folder"
                            Style="{StaticResource Button.SecondaryWithIcon}"
                            ToolTip="Create a virtual folder here" />

                    <!-- Breadcrumbs -->
                    <ItemsControl Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Current prefix"
                                  ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- The first crumb is the bucket root and has no leading chevron. -->
                                    <Path Style="{StaticResource Breadcrumb.Separator}"
                                          Visibility="{Binding IsFirst, Converter={StaticResource BoolToCollapsed}}" />

                                    <Button Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Prefix}"
                                            Content="{Binding DisplayName}"
                                            ToolTip="{Binding Prefix}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Breadcrumb.Segment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox x:Name="FilterBox"
                             Width="196"
                             controls:Placeholder.ClearCommand="{Binding ClearFilterCommand}"
                             controls:Placeholder.Text="Filter by name or prefix..."
                             AutomationProperties.HelpText="Filters the objects already loaded on this page. It does not query R2."
                             AutomationProperties.Name="Filter this page"
                             Style="{StaticResource TextBox.Search}"
                             Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter this page (Ctrl+F)" />

                    <ComboBox Width="164"
                              Margin="8,0,0,0"
                              Height="{StaticResource Size.ToolbarControlHeight}"
                              AutomationProperties.Name="Sort order"
                              DisplayMemberPath="DisplayName"
                              ItemContainerStyle="{StaticResource ComboBoxItem.Default}"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              Style="{StaticResource ComboBox.Default}"
                              ToolTip="Sort the loaded page. Folders always stay first." />

                    <!-- View mode -->
                    <StackPanel Margin="8,0,0,0" Orientation="Horizontal">
                        <RadioButton controls:Icon.Data="{StaticResource Icon.ViewList}"
                                     AutomationProperties.Name="List view"
                                     GroupName="FilesViewMode"
                                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumMatch}, ConverterParameter=List, Mode=TwoWay}"
                                     Style="{StaticResource ViewModeToggle}"
                                     ToolTip="List view" />
                        <RadioButton Margin="6,0,0,0"
                                     controls:Icon.Data="{StaticResource Icon.ViewGrid}"
                                     AutomationProperties.Name="Grid view"
                                     GroupName="FilesViewMode"
                                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumMatch}, ConverterParameter=Grid, Mode=TwoWay}"
                                     Style="{StaticResource ViewModeToggle}"
                                     ToolTip="Grid view" />
                    </StackPanel>

                    <Button Margin="8,0,0,0"
                            controls:Icon.Data="{StaticResource Icon.Inspector}"
                            AutomationProperties.Name="Toggle the inspector"
                            Command="{Binding ToggleInspectorCommand}"
                            ToolTip="Show or hide the inspector">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInspectorVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.StatusBar}" Text="{Binding ItemsSummary}" />
                    <Rectangle Style="{StaticResource Separator.StatusBar}" />
                    <TextBlock Style="{StaticResource Text.StatusBarMuted}" Text="{Binding BreakdownSummary}" />
                    <Rectangle Style="{StaticResource Separator.StatusBar}"
                               Visibility="{Binding SelectionSummary, Converter={StaticResource EmptyStringToCollapsed}}" />
                    <TextBlock Style="{StaticResource Text.StatusBarAccent}"
                               Text="{Binding SelectionSummary}"
                               Visibility="{Binding SelectionSummary, Converter={StaticResource EmptyStringToCollapsed}}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.StatusBarMuted}" Text="Listed size" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.StatusBar}" Text="{Binding ListedSizeSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" Style="{StaticResource Text.StatusBarMuted}" Text="{Binding PageSummary}" />
                    <Button Height="24"
                            controls:Icon.Data="{StaticResource Icon.ChevronLeft}"
                            AutomationProperties.Name="Previous page"
                            Command="{Binding PreviousPageCommand}"
                            Content="Previous"
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{StaticResource Button.GhostWithIcon}"
                            ToolTip="Load the previous page using its saved continuation token" />
                    <Button Margin="6,0,0,0"
                            Height="24"
                            controls:Icon.Data="{StaticResource Icon.ChevronRight}"
                            AutomationProperties.Name="Next page"
                            Command="{Binding NextPageCommand}"
                            Content="Next"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource Button.SecondaryWithIcon}"
                            ToolTip="Load the next page returned by R2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table + inspector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid x:Name="Grid"
                          AutomationProperties.Name="Objects and folders"
                          ItemsSource="{Binding Rows}"
                          SelectionChanged="OnGridSelectionChanged"
                          Style="{StaticResource DataGrid.Default}"
                          Visibility="{Binding ViewMode, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=List}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Default}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Download}"
                                      Command="{Binding DownloadCommand}"
                                      Header="Download"
                                      InputGestureText="Ctrl+D"
                                      IsEnabled="{Binding HasSelection}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Refresh}"
                                      Command="{Binding DownloadOverwriteCommand}"
                                      Header="Download &amp; overwrite..."
                                      IsEnabled="{Binding HasSelection}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Copy}"
                                      Command="{Binding CopyKeysCommand}"
                                      Header="Copy key"
                                      InputGestureText="Ctrl+K"
                                      IsEnabled="{Binding HasSelection}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Link}"
                                      Command="{Binding CopyPublicUrlsCommand}"
                                      Header="Copy public URL"
                                      IsEnabled="{Binding CanCopyPublicUrls}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.ExternalLink}"
                                      Command="{Binding OpenPublicUrlCommand}"
                                      Header="Open URL in browser"
                                      IsEnabled="{Binding CanOpenPublicUrl}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Clock}"
                                      Command="{Binding CreateTemporaryLinkCommand}"
                                      Header="Create temporary link..."
                                      IsEnabled="{Binding CanCreateTemporaryLink}" />

                            <Separator />

                            <MenuItem controls:Icon.Data="{StaticResource Icon.Pencil}"
                                      Command="{Binding RenameCommand}"
                                      Header="Rename..."
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRename}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Move}"
                                      Command="{Binding MoveCommand}"
                                      Header="Move to..."
                                      IsEnabled="{Binding HasSingleSelection}" />

                            <Separator />

                            <MenuItem controls:Icon.Data="{StaticResource Icon.Trash}"
                                      Command="{Binding DeleteCommand}"
                                      Header="Delete"
                                      InputGestureText="Del"
                                      IsEnabled="{Binding HasSelection}"
                                      Style="{StaticResource MenuItem.Danger}" />
                            <MenuItem controls:Icon.Data="{StaticResource Icon.Refresh}"
                                      Command="{Binding RefreshCommand}"
                                      Header="Refresh"
                                      InputGestureText="F5" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Selection lane -->
                        <DataGridTemplateColumn Width="34" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="10,0,0,0"
                                              AutomationProperties.Name="Select this row"
                                              Focusable="False"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource CheckBox.Default}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name -->
                        <DataGridTemplateColumn Width="*" Header="Name" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14"
                                              Height="14"
                                              Margin="4,0,10,0"
                                              VerticalAlignment="Center"
                                              Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                                              Stretch="Uniform"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <!-- Folders read as navigation, so they carry the accent. -->
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"
                                                   Text="{Binding DisplayName}"
                                                   ToolTip="{Binding ToolTipText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="130"
                                            Binding="{Binding TypeText}"
                                            ElementStyle="{StaticResource Cell.Secondary}"
                                            Header="Type"
                                            SortMemberPath="TypeText" />

                        <DataGridTextColumn Width="110"
                                            Binding="{Binding SizeText}"
                                            ElementStyle="{StaticResource Cell.Numeric}"
                                            Header="Size"
                                            SortMemberPath="SizeText">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Default}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="128"
                                            Binding="{Binding ModifiedText}"
                                            ElementStyle="{StaticResource Cell.Numeric}"
                                            Header="Last modified"
                                            SortMemberPath="ModifiedText">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Default}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="42" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button controls:Icon.Data="{StaticResource Icon.More}"
                                            AutomationProperties.Name="Object actions"
                                            Click="OnRowActionsClick"
                                            Style="{StaticResource Button.IconBorderless}"
                                            ToolTip="Object actions" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ListBox x:Name="Cards"
                         Padding="8"
                         AutomationProperties.Name="Objects and folders in grid view"
                         Background="{DynamicResource Brush.Surface}"
                         BorderThickness="0"
                         ContextMenu="{Binding ContextMenu, ElementName=Grid}"
                         ItemsSource="{Binding Rows}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="OnCardsSelectionChanged"
                         SelectionMode="Extended"
                         Visibility="{Binding ViewMode, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Grid}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="170" />
                            <Setter Property="Height" Value="96" />
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardRoot"
                                                Padding="12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource Radius.Control}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Path Width="26"
                                      Height="26"
                                      HorizontalAlignment="Left"
                                      Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.Accent}"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,8,0,0"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource Text.Body}"
                                           Text="{Binding DisplayName}"
                                           ToolTip="{Binding ToolTipText}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource Text.Value}"
                                           Text="{Binding TypeText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Loading, empty and error states share the table's slot. -->
                <Border Background="{DynamicResource Brush.Surface}"
                        Visibility="{Binding EmptyStateTitle, Converter={StaticResource EmptyStringToCollapsed}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <Path Width="34"
                              Height="34"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Center"
                              Data="{StaticResource Icon.Folder}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.TextMuted}"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round" />
                        <TextBlock Style="{StaticResource Placeholder.Title}" Text="{Binding EmptyStateTitle}" />
                        <TextBlock Style="{StaticResource Placeholder.Caption}" Text="{Binding EmptyStateMessage}" />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding RefreshCommand}"
                                Content="Try again"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding EmptyStateOffersRetry, Converter={StaticResource BoolToVisible}}" />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding GoToUploadCommand}"
                                Content="Upload files"
                                Style="{StaticResource Button.Primary}"
                                Visibility="{Binding EmptyStateOffersRetry, Converter={StaticResource BoolToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Brush.Surface}"
                        Opacity="0.75"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Control Style="{StaticResource Spinner}" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Placeholder.Caption}" Text="Listing objects…" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Inspector -->
            <files:FileInspectorView Grid.Column="1"
                                     Width="{StaticResource Size.InspectorWidth}"
                                     DataContext="{Binding Inspector}"
                                     Visibility="{Binding DataContext.IsInspectorVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </DockPanel>
</UserControl>
