<UserControl x:Class="CloudflareR2Uploader.Wpf.Views.Files.InspectorPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
             xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Files"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PreviewViewModel}"
             Focusable="False">

    <StackPanel>
        <!--
            The viewport keeps a fixed height in every state, which is what stops the whole
            inspector jumping as the user arrows down a list of mixed file types.
        -->
        <Border x:Name="Viewport" Height="178" Style="{StaticResource Placeholder.Box}">
            <Grid ClipToBounds="True">

                <!-- Loading -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Loading}">
                    <Control Style="{StaticResource Spinner}" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Placeholder.Caption}" Text="Fetching preview..." />
                </StackPanel>

                <!-- Image -->
                <Grid Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Image}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding Image}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Object preview">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <!-- Fit never upscales past the box and never distorts. -->
                                    <Setter Property="Stretch" Value="Uniform" />
                                    <Setter Property="StretchDirection" Value="DownOnly" />
                                    <Setter Property="Margin" Value="10" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFitToBox}" Value="False">
                                            <Setter Property="Stretch" Value="None" />
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </ScrollViewer>

                    <!-- Dimension chip -->
                    <Border Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Brush.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7,2,7,3"
                            Visibility="{Binding DimensionsText, Converter={StaticResource EmptyStringToCollapsed}}">
                        <TextBlock FontFamily="{StaticResource Fonts.Mono}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextSecondary}">
                            <Run Text="{Binding DimensionsText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Zoom, Mode=OneWay, StringFormat={}{0:P0}}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Text, JSON, XML, CSV, Markdown, HTML and SVG source -->
                <Grid Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Text}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBox Margin="10"
                                 AutomationProperties.Name="Object preview text"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource Fonts.Mono}"
                                 FontSize="{StaticResource Font.Size.Mono}"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 IsReadOnly="True"
                                 Text="{Binding Text, Mode=OneWay}"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>

                    <Border Margin="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource Badge.Paused}"
                            Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Style="{StaticResource Badge.Text}" Text="Truncated" />
                    </Border>
                </Grid>

                <!-- PDF, hosted locally -->
                <ContentControl x:Name="DocumentHost"
                                Focusable="False"
                                Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Pdf}" />

                <!-- Unsupported -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Unsupported}">
                    <Path Width="26"
                          Height="26"
                          HorizontalAlignment="Center"
                          Data="{StaticResource Icon.File}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.TextMuted}"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Placeholder.Title}" Text="{Binding PlaceholderTitle}" />
                    <TextBlock Style="{StaticResource Placeholder.Caption}" Text="{Binding PlaceholderCaption}" />
                </StackPanel>

                <!-- Nothing selected -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Empty}">
                    <Path Width="26"
                          Height="26"
                          HorizontalAlignment="Center"
                          Data="{StaticResource Icon.Inspector}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.TextMuted}"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Placeholder.Title}" Text="{Binding PlaceholderTitle}" />
                    <TextBlock Style="{StaticResource Placeholder.Caption}" Text="{Binding PlaceholderCaption}" />
                </StackPanel>

                <!-- Error -->
                <Border Style="{StaticResource Placeholder.Error}"
                        Visibility="{Binding State, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Error}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              Data="{StaticResource Icon.Alert}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Danger}"
                              StrokeThickness="1.4"
                              StrokeLineJoin="Round" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Placeholder.ErrorTitle}" Text="{Binding PlaceholderTitle}" />
                        <TextBlock Style="{StaticResource Placeholder.Caption}" Text="{Binding PlaceholderCaption}" />
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}"
                                Content="Try again"
                                Style="{StaticResource Button.Danger}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Zoom and open controls -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button controls:Icon.Data="{StaticResource Icon.Minus}"
                        AutomationProperties.Name="Zoom out"
                        Command="{Binding ZoomOutCommand}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Zoom out" />
                <Button Margin="6,0,0,0"
                        controls:Icon.Data="{StaticResource Icon.Plus}"
                        AutomationProperties.Name="Zoom in"
                        Command="{Binding ZoomInCommand}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Zoom in" />

                <Button Margin="10,0,0,0"
                        MinWidth="42"
                        Command="{Binding FitCommand}"
                        Content="Fit"
                        ToolTip="Fit the image inside the viewport">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFitToBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Margin="6,0,0,0"
                        MinWidth="42"
                        Command="{Binding ActualSizeCommand}"
                        Content="1:1"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Show the image at its actual pixel size" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button controls:Icon.Data="{StaticResource Icon.ExternalLink}"
                        AutomationProperties.Name="Open the preview locally"
                        Command="{Binding OpenCommand}"
                        Content="Open"
                        Style="{StaticResource Button.SecondaryWithIcon}"
                        ToolTip="Open the cached preview copy with the default Windows application" />
                <Button Margin="6,0,0,0"
                        controls:Icon.Data="{StaticResource Icon.Download}"
                        AutomationProperties.Name="Download this object"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Download this object" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
