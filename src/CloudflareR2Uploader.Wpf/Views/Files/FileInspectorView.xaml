<UserControl x:Class="CloudflareR2Uploader.Wpf.Views.Files.FileInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
             xmlns:files="clr-namespace:CloudflareR2Uploader.Wpf.Views.Files"
             xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Files"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FileInspectorViewModel}"
             Background="{DynamicResource Brush.Surface}"
             Focusable="False">

    <UserControl.Resources>
        <ContextMenu x:Key="InspectorOverflowMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem controls:Icon.Data="{StaticResource Icon.Copy}"
                      Command="{Binding CopyKeysCommand}"
                      Header="Copy key" />
            <MenuItem controls:Icon.Data="{StaticResource Icon.Copy}"
                      Command="{Binding CopyAllMetadataCommand}"
                      Header="Copy all metadata" />
            <MenuItem controls:Icon.Data="{StaticResource Icon.Clock}"
                      Command="{Binding CreateTemporaryLinkCommand}"
                      Header="Create temporary link..." />
        </ContextMenu>

        <!-- One metadata group, 96 px label lane, optional copy button. -->
        <DataTemplate x:Key="MetadataGroupTemplate">
            <Border Style="{StaticResource MetadataGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetadataGroup.Header}" Text="{Binding Header}" />
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource MetadataRow.Container}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource MetadataRow.Label}"
                                               Text="{Binding Label}" />

                                    <TextBlock Grid.Column="1" Text="{Binding Value}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetadataRow.Value}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonospace}" Value="True">
                                                        <Setter Property="FontFamily" Value="{StaticResource Fonts.Mono}" />
                                                        <Setter Property="FontSize" Value="{StaticResource Font.Size.Mono}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="2"
                                            controls:Icon.Data="{StaticResource Icon.Copy}"
                                            AutomationProperties.Name="Copy this value"
                                            Command="{Binding CopyCommand}"
                                            Style="{StaticResource CopyValueButton}"
                                            ToolTip="Copy to clipboard"
                                            Visibility="{Binding CanCopy, Converter={StaticResource BoolToVisible}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <Grid>
            <!-- Nothing selected -->
            <StackPanel Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToCollapsed}}">
                <Border Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Placeholder.Empty}">
                    <Path Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icon.File}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.TextMuted}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round" />
                </Border>
                <TextBlock Margin="0,14,0,0" Style="{StaticResource Placeholder.Title}" Text="No object selected" />
                <TextBlock Style="{StaticResource Placeholder.Caption}" Text="Pick a file to see its preview and metadata" />
            </StackPanel>

            <DockPanel LastChildFill="True" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">

                <!-- Header -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12,10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.Surface2}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="200"
                                           Style="{StaticResource Text.Subtitle}"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" />
                                <Border Margin="8,0,0,0"
                                        Style="{StaticResource Badge.Kind}"
                                        Visibility="{Binding KindBadge, Converter={StaticResource EmptyStringToCollapsed}}">
                                    <TextBlock Style="{StaticResource Badge.KindText}" Text="{Binding KindBadge}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Text.Mono}"
                                       Text="{Binding Subtitle}"
                                       ToolTip="{Binding Subtitle}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                VerticalAlignment="Top"
                                controls:Icon.Data="{StaticResource Icon.More}"
                                AutomationProperties.Name="More actions"
                                Click="OnOverflowClick"
                                ContextMenu="{StaticResource InspectorOverflowMenu}"
                                Style="{StaticResource Button.IconBorderless}"
                                ToolTip="More actions" />

                        <Button Grid.Column="3"
                                VerticalAlignment="Top"
                                controls:Icon.Data="{StaticResource Icon.Close}"
                                AutomationProperties.Name="Close the inspector"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource Button.IconBorderless}"
                                ToolTip="Close the inspector" />
                    </Grid>
                </Border>

                <!-- Footer, sticky -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="14,8,14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Margin="0,0,8,0"
                                Height="{StaticResource Size.DialogControlHeight}"
                                controls:Icon.Data="{StaticResource Icon.Download}"
                                AutomationProperties.Name="Download the selection"
                                Command="{Binding DownloadCommand}"
                                Content="{Binding DownloadLabel}"
                                Style="{StaticResource Button.PrimaryWithIcon}" />

                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Height="{StaticResource Size.DialogControlHeight}"
                                controls:Icon.Data="{StaticResource Icon.Link}"
                                AutomationProperties.Name="Copy link"
                                Command="{Binding CopyPublicUrlCommand}"
                                Content="Copy link"
                                IsEnabled="{Binding HasPublicUrl}"
                                Style="{StaticResource Button.SecondaryWithIcon}"
                                ToolTip="Copy the public URL for this object" />

                        <Button Grid.Column="2"
                                Height="{StaticResource Size.DialogControlHeight}"
                                controls:Icon.Data="{StaticResource Icon.More}"
                                AutomationProperties.Name="More actions"
                                Click="OnOverflowClick"
                                ContextMenu="{StaticResource InspectorOverflowMenu}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="More actions" />
                    </Grid>
                </Border>

                <!-- Body -->
                <Grid>
                    <!-- Single selection -->
                    <DockPanel LastChildFill="True" Visibility="{Binding IsMultiSelection, Converter={StaticResource BoolToCollapsed}}">
                        <Border DockPanel.Dock="Top"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="14,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Overview"
                                             GroupName="InspectorTabs"
                                             IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Overview, Mode=TwoWay}"
                                             Style="{StaticResource Tab.Inspector}" />
                                <RadioButton Content="Metadata"
                                             GroupName="InspectorTabs"
                                             IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Metadata, Mode=TwoWay}"
                                             Style="{StaticResource Tab.Inspector}" />
                                <RadioButton Content="Sharing"
                                             GroupName="InspectorTabs"
                                             IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Sharing, Mode=TwoWay}"
                                             Style="{StaticResource Tab.Inspector}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Padding="14,14,14,14" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <!-- Overview -->
                                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Overview}">
                                    <files:InspectorPreviewView DataContext="{Binding Preview}" />

                                    <ItemsControl Margin="0,16,0,0"
                                                  ItemTemplate="{StaticResource MetadataGroupTemplate}"
                                                  ItemsSource="{Binding Groups}" />

                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource MetadataRow.Label}" Text="Visibility" />
                                        <Border VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Private}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPublic}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5"
                                                         Height="5"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource Brush.Success}"
                                                         Visibility="{Binding IsPublic, Converter={StaticResource BoolToVisible}}" />
                                                <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding VisibilityText}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Metadata -->
                                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Metadata}">
                                    <Button HorizontalAlignment="Left"
                                            Margin="0,0,0,12"
                                            controls:Icon.Data="{StaticResource Icon.Copy}"
                                            Command="{Binding CopyAllMetadataCommand}"
                                            Content="Copy all"
                                            Style="{StaticResource Button.SecondaryWithIcon}" />

                                    <ItemsControl ItemTemplate="{StaticResource MetadataGroupTemplate}"
                                                  ItemsSource="{Binding MetadataGroups}" />

                                    <Border Style="{StaticResource Placeholder.Empty}"
                                            Padding="16"
                                            Visibility="{Binding MetadataGroups.Count, Converter={StaticResource ZeroCountToVisible}}">
                                        <TextBlock Style="{StaticResource Placeholder.Caption}"
                                                   Text="This object has no additional metadata." />
                                    </Border>
                                </StackPanel>

                                <!-- Sharing -->
                                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Sharing}">
                                    <TextBlock Style="{StaticResource Text.GroupHeader}" Text="PUBLIC ACCESS" />

                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource Text.Hint}"
                                               Text="A public base URL lets this app build a shareable link. It does not by itself make the bucket or the object public." />

                                    <TextBox Margin="0,10,0,0"
                                             AutomationProperties.Name="Public URL"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBox.Mono}"
                                             Text="{Binding PublicUrl, Mode=OneWay}" />

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Button controls:Icon.Data="{StaticResource Icon.Copy}"
                                                Command="{Binding CopyPublicUrlCommand}"
                                                Content="Copy URL"
                                                IsEnabled="{Binding HasPublicUrl}"
                                                Style="{StaticResource Button.SecondaryWithIcon}" />
                                        <Button Margin="8,0,0,0"
                                                controls:Icon.Data="{StaticResource Icon.ExternalLink}"
                                                Command="{Binding OpenPublicUrlCommand}"
                                                Content="Open URL"
                                                IsEnabled="{Binding HasPublicUrl}"
                                                Style="{StaticResource Button.SecondaryWithIcon}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,22,0,0" Style="{StaticResource Text.GroupHeader}" Text="TEMPORARY LINK" />

                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource Text.Hint}"
                                               Text="A temporary link is a signed HTTPS URL. Anyone who has it can download the object until it expires. It is never saved, logged or added to the activity history." />

                                    <Button Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            controls:Icon.Data="{StaticResource Icon.Clock}"
                                            Command="{Binding CreateTemporaryLinkCommand}"
                                            Content="Generate temporary link"
                                            Style="{StaticResource Button.PrimaryWithIcon}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Multiple selection -->
                    <ScrollViewer Padding="14"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsMultiSelection, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StatTile.Label}" Text="TOTAL SIZE" />
                                        <TextBlock Style="{StaticResource StatTile.Value}" Text="{Binding TotalSizeText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StatTile.Label}" Text="OBJECTS" />
                                        <TextBlock Style="{StaticResource StatTile.Value}" Text="{Binding ObjectCountText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Margin="0,18,0,8" Style="{StaticResource Text.GroupHeader}" Text="BY TYPE" />
                            <ItemsControl ItemsSource="{Binding TypeBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Value}" Text="{Binding TypeName}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Style="{StaticResource Text.Value}"
                                                       Text="{Binding CountText}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="16,0,0,0"
                                                       MinWidth="72"
                                                       Style="{StaticResource Text.Mono}"
                                                       Text="{Binding SizeText}"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,18,0,8" Style="{StaticResource Text.GroupHeader}" Text="SELECTED OBJECTS" />
                            <ItemsControl ItemsSource="{Binding SelectedObjects}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Width="13"
                                                  Height="13"
                                                  Margin="0,0,9,0"
                                                  VerticalAlignment="Center"
                                                  Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource Brush.TextMuted}"
                                                  StrokeThickness="1.3"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Body}"
                                                       Text="{Binding DisplayName}"
                                                       ToolTip="{Binding ToolTipText}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Mono}"
                                                       Text="{Binding SizeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
