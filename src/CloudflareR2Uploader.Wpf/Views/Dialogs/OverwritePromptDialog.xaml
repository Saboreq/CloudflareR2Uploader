<dialogs:ThemedDialogWindow x:Class="CloudflareR2Uploader.Wpf.Views.Dialogs.OverwritePromptDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
                           xmlns:dialogs="clr-namespace:CloudflareR2Uploader.Wpf.Views.Dialogs"
                           xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Dialogs"
                           mc:Ignorable="d"
                           d:DataContext="{d:DesignInstance Type=vm:OverwritePromptViewModel}"
                           Title="This object already exists"
                           Width="520"
                           SizeToContent="Height"
                           Style="{StaticResource Dialog.Window}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Dialog.Header}">
            <StackPanel Orientation="Horizontal">
                <Path Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icon.Alert}"
                      Stretch="Uniform"
                      Stroke="{DynamicResource Brush.Warning}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <TextBlock Style="{StaticResource Dialog.Title}" Text="This object already exists" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Dialog.Body}">
            <StackPanel>
                <TextBlock Style="{StaticResource Dialog.Message}"
                           Text="An object with this key is already in the bucket. Choose what to do with it." />

                <Border Margin="0,14,0,0" Style="{StaticResource Placeholder.Box}" Padding="12,10,12,11">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.MonoPrimary}"
                                   Text="{Binding ObjectKey}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ObjectKey}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OverwriteLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       Style="{StaticResource Text.Value}"
                                       Text="In the bucket" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Body}"
                                       Text="{Binding ExistingDescription}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OverwriteLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       Style="{StaticResource Text.Value}"
                                       Text="Local file" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Body}"
                                       Text="{Binding LocalDescription}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        HorizontalAlignment="Left"
                        Height="{StaticResource Size.DialogControlHeight}"
                        Command="{Binding CancelAllCommand}"
                        Content="Cancel all uploads"
                        IsCancel="True"
                        Style="{StaticResource Button.Ghost}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Height="{StaticResource Size.DialogControlHeight}"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Command="{Binding SkipCommand}"
                            Content="Skip"
                            Style="{StaticResource Button.Secondary}" />
                    <Button Height="{StaticResource Size.DialogControlHeight}"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Command="{Binding RenameCommand}"
                            Content="Keep both"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Upload under a new name such as &quot;file (1).zip&quot;" />
                    <Button Height="{StaticResource Size.DialogControlHeight}"
                            MinWidth="88"
                            Command="{Binding OverwriteCommand}"
                            Content="Overwrite"
                            IsDefault="True"
                            Style="{StaticResource Button.Danger}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:ThemedDialogWindow>
