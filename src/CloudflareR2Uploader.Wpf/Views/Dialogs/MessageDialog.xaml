<dialogs:ThemedDialogWindow x:Class="CloudflareR2Uploader.Wpf.Views.Dialogs.MessageDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
                           xmlns:dialogs="clr-namespace:CloudflareR2Uploader.Wpf.Views.Dialogs"
                           xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Dialogs"
                           mc:Ignorable="d"
                           d:DataContext="{d:DesignInstance Type=vm:MessageDialogViewModel}"
                           Title="{Binding Title}"
                           Width="460"
                           SizeToContent="Height"
                           MaxHeight="620"
                           Style="{StaticResource Dialog.Window}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Dialog.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icon.Info}"
                      Stretch="Uniform"
                      Stroke="{DynamicResource Brush.Accent}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource Dialog.Title}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2"
                        controls:Icon.Data="{StaticResource Icon.Close}"
                        AutomationProperties.Name="Close"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Style="{StaticResource Button.IconBorderless}"
                        ToolTip="Close (Escape)" />
            </Grid>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Style="{StaticResource Dialog.Body}">
            <StackPanel>
                <TextBlock Style="{StaticResource Dialog.Message}" Text="{Binding Message}" />

                <CheckBox Margin="0,16,0,0"
                          Content="{Binding OptionLabel}"
                          IsChecked="{Binding IsOptionChecked, Mode=TwoWay}"
                          Style="{StaticResource CheckBox.Default}"
                          Visibility="{Binding HasOption, Converter={StaticResource BoolToVisible}}" />

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisible}}">
                    <Button HorizontalAlignment="Left"
                            Command="{Binding ToggleDetailsCommand}"
                            Content="{Binding DetailsHeader}"
                            Style="{StaticResource Button.Link}" />

                    <Border Margin="0,8,0,0"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            MaxHeight="220"
                            Visibility="{Binding AreDetailsExpanded, Converter={StaticResource BoolToVisible}}">
                        <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource Fonts.Mono}"
                                     FontSize="{StaticResource Font.Size.Mono}"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     IsReadOnly="True"
                                     Text="{Binding Details, Mode=OneWay}"
                                     TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Height="{StaticResource Size.DialogControlHeight}"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisible}}" />

                <Button Height="{StaticResource Size.DialogControlHeight}"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Command="{Binding AlternateCommand}"
                        Content="{Binding AlternateLabel}"
                        Style="{StaticResource Button.Secondary}"
                        Visibility="{Binding HasAlternate, Converter={StaticResource BoolToVisible}}" />

                <Button Height="{StaticResource Size.DialogControlHeight}"
                        MinWidth="88"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmLabel}"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}"
                        Visibility="{Binding IsDestructive, Converter={StaticResource BoolToCollapsed}}" />

                <Button Height="{StaticResource Size.DialogControlHeight}"
                        MinWidth="88"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmLabel}"
                        IsDefault="True"
                        Style="{StaticResource Button.Danger}"
                        Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:ThemedDialogWindow>
