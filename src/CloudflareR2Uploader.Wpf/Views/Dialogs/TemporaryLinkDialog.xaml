<dialogs:ThemedDialogWindow x:Class="CloudflareR2Uploader.Wpf.Views.Dialogs.TemporaryLinkDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
                           xmlns:dialogs="clr-namespace:CloudflareR2Uploader.Wpf.Views.Dialogs"
                           xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Dialogs"
                           mc:Ignorable="d"
                           d:DataContext="{d:DesignInstance Type=vm:TemporaryLinkDialogViewModel}"
                           Title="Temporary link"
                           Width="560"
                           SizeToContent="Height"
                           Style="{StaticResource Dialog.Window}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Dialog.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icon.Clock}"
                      Stretch="Uniform"
                      Stroke="{DynamicResource Brush.Accent}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <TextBlock Grid.Column="1" Style="{StaticResource Dialog.Title}" Text="Temporary link created" />
                <Button Grid.Column="2"
                        controls:Icon.Data="{StaticResource Icon.Close}"
                        AutomationProperties.Name="Close"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        Style="{StaticResource Button.IconBorderless}"
                        ToolTip="Close (Escape)" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Dialog.Body}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.GroupHeader}" Text="OBJECT" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Text.MonoPrimary}"
                           Text="{Binding ObjectKey}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ObjectKey}" />

                <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.GroupHeader}" Text="LINK" />
                <TextBox Margin="0,6,0,0"
                         AutomationProperties.Name="Temporary download link"
                         IsReadOnly="True"
                         MaxHeight="88"
                         Style="{StaticResource TextBox.Mono}"
                         Text="{Binding Url, Mode=OneWay}"
                         TextWrapping="Wrap"
                         Height="Auto"
                         Padding="10,7,10,7"
                         VerticalContentAlignment="Top" />

                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource Text.Value}"
                           Text="{Binding ExpiryDescription}" />

                <!-- Warning is a permanent part of the dialog, not a transient toast. -->
                <Border Margin="0,16,0,0"
                        Background="{DynamicResource Brush.WarningWash}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="12,10,12,11">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15"
                              Height="15"
                              Margin="0,1,10,0"
                              VerticalAlignment="Top"
                              Data="{StaticResource Icon.Alert}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Warning}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <TextBlock MaxWidth="440"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Style="{StaticResource Dialog.Message}"
                                   Text="{Binding Warning}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding WasCopied, Converter={StaticResource BoolToVisible}}">
                    <Path Width="13"
                          Height="13"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icon.Check}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Success}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <TextBlock Foreground="{DynamicResource Brush.Success}"
                               Style="{StaticResource Text.Value}"
                               Text="Copied to clipboard" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Height="{StaticResource Size.DialogControlHeight}"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Command="{Binding OpenCommand}"
                            Content="Open"
                            Style="{StaticResource Button.Secondary}" />
                    <Button Height="{StaticResource Size.DialogControlHeight}"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Command="{Binding CopyCommand}"
                            Content="Copy link"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                    <Button Height="{StaticResource Size.DialogControlHeight}"
                            MinWidth="88"
                            Command="{Binding CloseCommand}"
                            Content="Close"
                            Style="{StaticResource Button.Ghost}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:ThemedDialogWindow>
