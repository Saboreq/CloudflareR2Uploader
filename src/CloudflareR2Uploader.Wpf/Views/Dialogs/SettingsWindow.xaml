<dialogs:ThemedDialogWindow x:Class="CloudflareR2Uploader.Wpf.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
        xmlns:dialogs="clr-namespace:CloudflareR2Uploader.Wpf.Views.Dialogs"
        Title="Settings"
        Width="880"
        Height="610"
        MinWidth="820"
        MinHeight="560"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Style="{StaticResource Dialog.Window}">
    <dialogs:ThemedDialogWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </dialogs:ThemedDialogWindow.InputBindings>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Panel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Dialog.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"
                          Data="{StaticResource Icon.Settings}" Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
                    <TextBlock Style="{StaticResource Dialog.Title}" Text="Settings" />
                </StackPanel>
                <Button Grid.Column="1" controls:Icon.Data="{StaticResource Icon.Close}"
                        AutomationProperties.Name="Close settings"
                        Command="{Binding CancelCommand}" Style="{StaticResource Button.IconBorderless}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
                    Padding="10,12">
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Settings sections">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="2,0,0,0" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="13" Height="13" VerticalAlignment="Center"
                                      Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                                      Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                      StrokeThickness="1.4" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{Binding DataContext.Profiles.Count, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="buckets">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Ellipse Grid.Column="2"
                                         Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Accent}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="updates">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20,18,24,22">
                    <Grid.Resources>
                        <Style x:Key="SettingsHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="TextTrimming" Value="None" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                        </Style>
                        <Style x:Key="SettingsSubheading" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="TextTrimming" Value="None" />
                            <Setter Property="Margin" Value="0,22,0,3" />
                        </Style>
                        <Style x:Key="SettingsLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
                            <Setter Property="Width" Value="154" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Style>
                    </Grid.Resources>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=buckets}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Bucket profiles" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Manage the R2 targets shown in the main window bucket selector." />
                        <ListBox Margin="0,16,0,12" MinHeight="180" ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"
                                 Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1" Padding="4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Bucket name" />
                            <TextBox Grid.Column="1" AutomationProperties.Name="Bucket name" Style="{StaticResource TextBox.Default}" Text="{Binding BucketName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add bucket" Command="{Binding AddProfileCommand}" Style="{StaticResource Button.Primary}" />
                            <Button Margin="8,0,0,0" Content="Remove" Command="{Binding RemoveProfileCommand}" Style="{StaticResource Button.Danger}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=connection}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="S3 credentials" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Stored locally and sent only to your configured R2 endpoint." />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SettingsLabel}" Text="Account ID" />
                            <TextBox Grid.Row="0" Grid.Column="1" AutomationProperties.Name="Account ID" Style="{StaticResource TextBox.Mono}" Text="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource SettingsLabel}" Text="Access key ID" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Access key ID" Style="{StaticResource TextBox.Mono}" Text="{Binding AccessKeyId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource SettingsLabel}" Text="Secret access key" />
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="SecretPasswordBox" PasswordChanged="OnSecretPasswordChanged"
                                             AutomationProperties.Name="Secret access key">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.Default}">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsSecretRevealed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>
                                <TextBox Grid.Column="0" AutomationProperties.Name="Revealed secret access key"
                                         Text="{Binding SecretAccessKey, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Mono}">
                                            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSecretRevealed}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ToggleSecretVisibilityCommand}"
                                        Content="Show" Style="{StaticResource Button.Secondary}" />
                            </Grid>
                            <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource SettingsLabel}" Text="Endpoint" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                                <TextBox AutomationProperties.Name="R2 endpoint" Style="{StaticResource TextBox.Mono}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.FieldError}" Text="{Binding EndpointError}" Visibility="{Binding EndpointError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSubheading}" Text="Public access" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Used when copying public URLs and opening objects in the browser." />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Public base URL" />
                            <StackPanel Grid.Column="1">
                                <TextBox AutomationProperties.Name="Public base URL" Style="{StaticResource TextBox.Mono}" Text="{Binding PublicBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.FieldError}" Text="{Binding PublicBaseUrlError}" Visibility="{Binding PublicBaseUrlError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource SettingsLabel}" Text="Temporary link expiry" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal">
                                <ComboBox Width="180" HorizontalAlignment="Left"
                                          ItemsSource="{Binding ExpiryChoices}" SelectedItem="{Binding SelectedExpiry}" DisplayMemberPath="DisplayName"
                                          ItemContainerStyle="{StaticResource ComboBoxItem.Default}" Style="{StaticResource ComboBox.Default}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Hint}" Text="Maximum allowed by R2 is 7 days." />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource SettingsLabel}" Text="Prefer public URLs" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding PreferPublicUrls}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Copy the CDN URL when public access is configured" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSubheading}" Text="Credential storage" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Storage backend" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding RememberCredentials}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Protect saved credentials with Windows DPAPI" />
                                <Border Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Completed}">
                                    <TextBlock Style="{StaticResource Badge.Text}" Text="DPAPI encrypted" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Session" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding ForgetCredentialsOnExit}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Forget credentials when the app exits" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=transfers}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Transfer settings" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Applies to uploads and downloads for the active bucket connection." />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Parallel transfers" /><ComboBox Grid.Column="1" ItemsSource="{Binding ParallelChoices}" SelectedItem="{Binding SelectedParallel}" DisplayMemberPath="DisplayName" ItemContainerStyle="{StaticResource ComboBoxItem.Default}" Style="{StaticResource ComboBox.Default}"/><TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Text="Higher values can trigger R2 rate limits."/>
                            <TextBlock Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource SettingsLabel}" Text="Multipart threshold"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                <TextBox Padding="10,0,34,0" Style="{StaticResource TextBox.Numeric}" Text="{Binding MultipartThresholdText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Text.Mono}" Text="MB"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,12,0,0" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Text="Files above this size upload in parts."/>
                            <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource SettingsLabel}" Text="Part size"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                <TextBox Padding="10,0,34,0" Style="{StaticResource TextBox.Numeric}" Text="{Binding PartSizeText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Text.Mono}" Text="MB"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,12,0,0" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Text="Minimum 5 MB · maximum 5 GB."/>
                            <TextBlock Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource SettingsLabel}" Text="Retries on failure"/><ComboBox Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding RetryChoices}" SelectedItem="{Binding SelectedRetry}" DisplayMemberPath="DisplayName" ItemContainerStyle="{StaticResource ComboBoxItem.Default}" Style="{StaticResource ComboBox.Default}"/><TextBlock Grid.Row="3" Grid.Column="2" Margin="12,12,0,0" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Text="Exponential backoff between attempts."/>
                            <TextBlock Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource SettingsLabel}" Text="Integrity"/><StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal"><ToggleButton IsChecked="{Binding VerifyETagAfterUpload}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Verify ETag after every upload"/></StackPanel>
                        </Grid>
                        <TextBlock Margin="170,5,0,0" Style="{StaticResource Text.FieldError}" Text="{Binding MultipartThresholdError}" Visibility="{Binding MultipartThresholdError, Converter={StaticResource NullToCollapsed}}"/>
                        <TextBlock Margin="170,5,0,0" Style="{StaticResource Text.FieldError}" Text="{Binding PartSizeError}" Visibility="{Binding PartSizeError, Converter={StaticResource NullToCollapsed}}"/>

                        <TextBlock Margin="0,22,0,0" Style="{StaticResource SettingsHeading}" Text="Application behaviour" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Window, tray, and startup behaviour on Windows." />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Startup" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding StartWithWindowsAndMinimized}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Start with Windows, minimised to tray" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsLabel}" Text="Close button" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding CloseToTray}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Minimise to the tray instead of quitting" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Style="{StaticResource SettingsLabel}" Text="Background transfers" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ContinueTransfersWhileMinimized}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Continue the queue while minimised" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Style="{StaticResource SettingsLabel}" Text="Confirmations" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ConfirmDeletes}" Style="{StaticResource ToggleSwitch}" />
                                <TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Ask before deleting objects" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Style="{StaticResource SettingsLabel}" Text="Theme" />
                            <Border Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Dark" GroupName="TransferTheme" IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Dark, Mode=TwoWay}" Style="{StaticResource SegmentedControl.Segment}" />
                                    <RadioButton Content="Light" GroupName="TransferTheme" IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Light, Mode=TwoWay}" Style="{StaticResource SegmentedControl.Segment}" />
                                    <RadioButton Content="System" GroupName="TransferTheme" IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=System, Mode=TwoWay}" Style="{StaticResource SegmentedControl.Segment}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=application}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Application behaviour" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Window, tray, and startup behaviour on Windows." />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                <RowDefinition Height="44"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Start with Windows" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding StartWithWindows}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Launch automatically after sign-in"/></StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsLabel}" Text="Startup state" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding StartMinimized}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Start minimised to the tray"/></StackPanel>
                            <TextBlock Grid.Row="2" Style="{StaticResource SettingsLabel}" Text="Close button" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding CloseToTray}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Minimise to the tray instead of quitting"/></StackPanel>
                            <TextBlock Grid.Row="3" Style="{StaticResource SettingsLabel}" Text="Minimise button" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding MinimizeToTray}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Minimise the main window to the tray"/></StackPanel>
                            <TextBlock Grid.Row="4" Style="{StaticResource SettingsLabel}" Text="Background transfers" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding ContinueTransfersWhileMinimized}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Continue the queue while minimised"/></StackPanel>
                            <TextBlock Grid.Row="5" Style="{StaticResource SettingsLabel}" Text="Confirmations" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding ConfirmDeletes}" Style="{StaticResource ToggleSwitch}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="Ask before deleting objects"/></StackPanel>
                            <TextBlock Grid.Row="6" Style="{StaticResource SettingsLabel}" Text="Theme" />
                            <Border Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Dark" GroupName="ApplicationTheme" IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Dark, Mode=TwoWay}" Style="{StaticResource SegmentedControl.Segment}"/>
                                    <RadioButton Content="Light" GroupName="ApplicationTheme" IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Light, Mode=TwoWay}" Style="{StaticResource SegmentedControl.Segment}"/>
                                    <RadioButton Content="System" GroupName="ApplicationTheme" IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=System, Mode=TwoWay}" Style="{StaticResource SegmentedControl.Segment}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=notifications}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Notifications" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Notifications contain safe summaries only; object keys and signed URLs are omitted." />
                        <StackPanel Margin="0,16,0,0">
                            <CheckBox Margin="0,0,0,12" Content="Enable tray notifications" IsChecked="{Binding ShowTrayNotifications}" Style="{StaticResource CheckBox.Default}"/>
                            <CheckBox Margin="0,0,0,12" Content="Transfer completed" IsChecked="{Binding NotifyOnTransferComplete}" Style="{StaticResource CheckBox.Default}"/>
                            <CheckBox Margin="0,0,0,12" Content="Transfer failed" IsChecked="{Binding NotifyOnTransferFailure}" Style="{StaticResource CheckBox.Default}"/>
                            <CheckBox Margin="0,0,0,12" Content="Connection errors" IsChecked="{Binding NotifyOnConnectionError}" Style="{StaticResource CheckBox.Default}"/>
                            <CheckBox Content="Update available" IsChecked="{Binding NotifyOnUpdateAvailable}" Style="{StaticResource CheckBox.Default}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=updates}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Updates" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="Installer downloads are verified against the exact length and SHA-256 in the update manifest." />
                        <CheckBox Margin="0,16,0,14" Content="Check for updates automatically" IsChecked="{Binding CheckForUpdatesAutomatically}" Style="{StaticResource CheckBox.Default}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Width="150" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource Button.Secondary}"/>
                            <Button Width="160" Margin="10,0,0,0" Content="Download and install" Command="{Binding InstallUpdateCommand}" Style="{StaticResource Button.Primary}" Visibility="{Binding AvailableVersion, Converter={StaticResource EmptyStringToCollapsed}}"/>
                        </StackPanel>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Body}" Text="{Binding UpdateStatus}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.SectionTitle}" Text="{Binding AvailableVersion, StringFormat=Available version: {0}}" Visibility="{Binding AvailableVersion, Converter={StaticResource EmptyStringToCollapsed}}"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Value}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Visibility="{Binding ReleaseNotes, Converter={StaticResource EmptyStringToCollapsed}}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection.Key, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=about}">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Cloudflare R2 Uploader" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Hint}" Text="{Binding CurrentVersion, StringFormat=Version {0}}" />
                        <TextBlock Margin="0,22,0,0" Style="{StaticResource Text.SectionTitle}" Text="Activity retention"/>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><TextBox Width="100" Style="{StaticResource TextBox.Numeric}" Text="{Binding ActivityRetentionText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Text.ToggleCaption}" Text="days"/></StackPanel>
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.FieldError}" Text="{Binding ActivityRetentionError}" Visibility="{Binding ActivityRetentionError, Converter={StaticResource NullToCollapsed}}"/>
                        <TextBlock Style="{StaticResource SettingsSubheading}" Text="Locations"/>
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding LogDirectory}" TextWrapping="Wrap"/>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><Button Content="Open logs" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource Button.Secondary}"/><Button Margin="8,0,0,0" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource Button.Secondary}"/><Button Margin="8,0,0,0" Content="Repository" Command="{Binding OpenRepositoryCommand}" Style="{StaticResource Button.Ghost}"/></StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource Button.Secondary}"/>
                    <!--
                        The chip reports the outcome of the last test, so before one has run
                        it is hidden rather than showing the enum's "Unknown", which means
                        nothing to a user. Colour matches the outcome, and the word is always
                        present so the state never depends on colour alone.
                    -->
                    <Border Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Badge.Neutral}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestState}" Value="Testing">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TestState}" Value="Connected">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TestState}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TestState}" Value="NotConfigured">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding TestStateText}" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Hint}" Text="{Binding TestSummary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Secondary}" IsCancel="True"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</dialogs:ThemedDialogWindow>
