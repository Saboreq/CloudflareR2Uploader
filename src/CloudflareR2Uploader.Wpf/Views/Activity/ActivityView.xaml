<UserControl x:Class="CloudflareR2Uploader.Wpf.Views.Activity.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CloudflareR2Uploader.Wpf.Controls"
             xmlns:vm="clr-namespace:CloudflareR2Uploader.Wpf.ViewModels.Activity"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ActivityViewModel}"
             Background="{DynamicResource Brush.Background}"
             Focusable="False">

    <DockPanel LastChildFill="True">

        <!-- Filters -->
        <Border DockPanel.Dock="Top" Padding="12,7,12,7" Style="{StaticResource Panel.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ListBox ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Activity filters">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Pill}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="ActivityFilters"
                                         IsHitTestVisible="False"
                                         AutomationProperties.Name="{Binding DisplayName}"
                                         Style="{StaticResource Chip.Filter}">
                                <RadioButton.IsChecked>
                                    <Binding Path="IsSelected"
                                             RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                                             Mode="OneWay" />
                                </RadioButton.IsChecked>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <Border Margin="7,0,0,0"
                                            Style="{StaticResource Badge.CountDanger}"
                                            Visibility="{Binding ErrorsOnly, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource Badge.Text}"
                                                   Text="{Binding DataContext.ErrorCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox Width="150"
                              Margin="0,0,10,0"
                              AutomationProperties.Name="Date range"
                              DisplayMemberPath="DisplayName"
                              ItemContainerStyle="{StaticResource ComboBoxItem.Default}"
                              ItemsSource="{Binding DateRanges}"
                              SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                              Style="{StaticResource ComboBox.Default}" />

                    <TextBox Width="210"
                             controls:Placeholder.Text="Search activity..."
                             AutomationProperties.Name="Search the activity history"
                             Style="{StaticResource TextBox.Search}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Margin="10,0,0,0"
                            controls:Icon.Data="{StaticResource Icon.Download}"
                            AutomationProperties.HelpText="Exports the events currently in view. Secrets and signed URLs are never included."
                            AutomationProperties.Name="Export the activity history as CSV"
                            Command="{Binding ExportCsvCommand}"
                            Content="Export CSV"
                            Style="{StaticResource Button.SecondaryWithIcon}" />

                    <Button Margin="8,0,0,0"
                            AutomationProperties.Name="Clear the activity history"
                            Command="{Binding ClearHistoryCommand}"
                            Content="Clear history"
                            Style="{StaticResource Button.Ghost}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Text.StatusBar}" Text="{Binding FooterCounts}" />

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.StatusBarMuted}" Text="Transferred in range" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.StatusBar}" Text="{Binding FooterTransferred}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Style="{StaticResource Text.StatusBarMuted}" Text="{Binding RetentionText}" />
            </Grid>
        </Border>

        <!-- Column heads -->
        <Border DockPanel.Dock="Top"
                Height="30"
                Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Action" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Object" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Bucket" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Size" TextAlignment="Right" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Duration" TextAlignment="Right" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Time" TextAlignment="Right" />
                <TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource Text.ColumnHeader}" Text="Result" TextAlignment="Right" />
            </Grid>
        </Border>

        <Grid>
            <!-- Empty -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                <Path Width="30"
                      Height="30"
                      HorizontalAlignment="Center"
                      Data="{StaticResource Icon.Clock}"
                      Stretch="Uniform"
                      Stroke="{DynamicResource Brush.TextMuted}"
                      StrokeThickness="1.2"
                      StrokeLineJoin="Round" />
                <TextBlock Margin="0,14,0,0" Style="{StaticResource Placeholder.Title}" Text="No activity in this range" />
                <TextBlock Style="{StaticResource Placeholder.Caption}"
                           Text="Uploads, downloads and changes appear here as they happen." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsed}}">
                <ItemsControl AutomationProperties.Name="Activity history"
                              ItemsSource="{Binding Groups}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Date group header -->
                                <Border Height="26"
                                        Background="{DynamicResource Brush.Surface2}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{Binding Header}" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Style="{StaticResource Text.Value}"
                                                   Text="{Binding Summary}" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="32"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid Margin="12,0,12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <Path Width="13"
                                                              Height="13"
                                                              Margin="0,0,9,0"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                                                              Stretch="Uniform"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Style="{StaticResource Text.Body}"
                                                                   Text="{Binding ActionText}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding ObjectText}"
                                                               ToolTip="{Binding ObjectText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Value}"
                                                               Text="{Binding BucketText}" />
                                                    <TextBlock Grid.Column="3"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Mono}"
                                                               Text="{Binding SizeText}"
                                                               TextAlignment="Right" />
                                                    <TextBlock Grid.Column="4"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Mono}"
                                                               Text="{Binding DurationText}"
                                                               TextAlignment="Right" />
                                                    <TextBlock Grid.Column="5"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource Text.Mono}"
                                                               Text="{Binding TimeText}"
                                                               TextAlignment="Right" />

                                                    <Border Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Badge.Completed}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding ResultText}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
