{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saboreq/CloudflareR2Uploader/blob/main/deploy/update-manifest.schema.json",
  "title": "Cloudflare R2 Uploader update manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "version", "installerUrl", "sha256", "sizeBytes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "installerUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
    "publishedUtc": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 8000 }
  }
}
