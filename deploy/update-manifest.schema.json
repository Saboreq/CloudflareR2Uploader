{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saboreq/CloudflareR2Uploader/blob/main/deploy/update-manifest.schema.json",
  "title": "Cloudflare R2 Uploader update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "installerUrl", "sha256", "sizeBytes", "publishedUtc", "notes", "signatureAlgorithm", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?![\\s\\S])" },
    "installerUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
    "publishedUtc": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 8000 },
    "signatureAlgorithm": { "const": "RSA-PSS-SHA256" },
    "signature": { "type": "string", "minLength": 1, "maxLength": 16384, "contentEncoding": "base64" }
  }
}
